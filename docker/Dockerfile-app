# the project inside the image: a bind mount of the project directory is slow on Windows (WSL2);
# `docker compose watch` copies changed files into the running container (develop.watch in docker-compose.yaml)
# php is the runtime of docker/Dockerfile, given by additional_contexts in docker-compose.yaml
FROM php

WORKDIR /var/www/html
COPY . .

# the application writes its cache, sessions, logs and uploads; bin/project-setup runs as www-data, and the
# migrations write their report of this database to .drago-project/; nothing else is writable (the php image gives
# www-data the project root with 1777)
RUN mkdir -p temp/sessions log www/upload .drago-project \
    && chown root:root . && chmod 755 . \
    && chown -R www-data:www-data temp log www/upload .drago-project
